#!/bin/sh
# Guard for the encrypted pages (/p/, /cv/): never let plaintext or a password reach a commit.
# Installed with: git config core.hooksPath scripts/git-hooks

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

if printf '%s\n' "$staged" | grep -qE '^_private/'; then
  echo "pre-commit: refusing to commit files under _private/ (plaintext / password)." >&2
  exit 1
fi

if printf '%s\n' "$staged" | grep -qx 'p/index.html'; then
  content=$(git show :p/index.html)
  case "$content" in
    *staticrypt*) ;;
    *) echo "pre-commit: p/index.html is not staticrypt output." >&2; exit 1 ;;
  esac
  if printf '%s' "$content" | grep -qF 'id="page-data"'; then
    echo "pre-commit: p/index.html contains the plaintext data block; rebuild it." >&2
    exit 1
  fi
fi

if printf '%s\n' "$staged" | grep -qx 'cv/index.html'; then
  content=$(git show :cv/index.html)
  case "$content" in
    *staticrypt*) ;;
    *) echo "pre-commit: cv/index.html is not staticrypt output." >&2; exit 1 ;;
  esac
  if printf '%s' "$content" | grep -qF 'PLAINTEXT full CV'; then
    echo "pre-commit: cv/index.html contains the plaintext CV; run npm run build:cv." >&2
    exit 1
  fi
fi

for pwfile in _private/.password _private/.cv_password; do
  [ -f "$pwfile" ] || continue
  pw=$(tr -d '\r\n' < "$pwfile")
  [ -n "$pw" ] || continue
  for f in $staged; do
    if git show ":$f" 2>/dev/null | grep -qF -- "$pw"; then
      echo "pre-commit: the password from $pwfile appears in staged file $f." >&2
      exit 1
    fi
  done
done

exit 0
