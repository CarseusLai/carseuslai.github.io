#!/bin/sh
# Guard for the private job tracker: never let plaintext data or the password reach a commit.
# Installed with: git config core.hooksPath scripts/git-hooks

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

if printf '%s\n' "$staged" | grep -qE '^_private/'; then
  echo "pre-commit: refusing to commit files under _private/ (plaintext job data / password)." >&2
  exit 1
fi

if printf '%s\n' "$staged" | grep -qx 'jobs/index.html'; then
  content=$(git show :jobs/index.html)
  case "$content" in
    *staticrypt*) ;;
    *) echo "pre-commit: jobs/index.html is not staticrypt output." >&2; exit 1 ;;
  esac
  if printf '%s' "$content" | grep -q '__JOBS_JSON__\|"jobs":\['; then
    echo "pre-commit: jobs/index.html contains plaintext markers; run npm run build:jobs." >&2
    exit 1
  fi
fi

if [ -f _private/.jobs_password ]; then
  pw=$(cat _private/.jobs_password | tr -d '\r\n')
  if [ -n "$pw" ]; then
    for f in $staged; do
      if git show ":$f" 2>/dev/null | grep -qF -- "$pw"; then
        echo "pre-commit: the job-tracker password appears in staged file $f." >&2
        exit 1
      fi
    done
  fi
fi

exit 0
